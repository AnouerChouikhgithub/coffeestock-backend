###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=change-me-in-local-dev
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Used by `framework.router.default_uri` to generate URLs outside an HTTP request
# (CLI commands, tests). The application cannot boot without it.
DEFAULT_URI=http://localhost:8000
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Local development database. `compose.yaml` publishes it on host port 6543.
DATABASE_URL="postgresql://coffeestock:coffeestock@127.0.0.1:6543/coffeestock_dev?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###

###> nelmio/cors-bundle ###
# Allowed browser origins for the Vite dev server; anchored regex.
CORS_ALLOW_ORIGIN=^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$
###< nelmio/cors-bundle ###
